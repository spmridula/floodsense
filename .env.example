# Copy to .env (scripts do this for you). Placeholders only - never commit real secrets.
FLOODSENSE_ENV=local
FLOODSENSE_LOG_LEVEL=INFO
# Default is a SQLite file under ./data. For PostgreSQL later: postgresql+psycopg://user:password@host:5432/floodsense
# FLOODSENSE_DATABASE_URL=
# JSON list. Must not contain "*" when FLOODSENSE_ENV=production
FLOODSENSE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
FLOODSENSE_REFRESH_INTERVAL_SECONDS=900
FLOODSENSE_STALE_AFTER_SECONDS=10800
